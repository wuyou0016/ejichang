---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShell from '../../components/PageShell.astro';
import BrandTable from '../../components/BrandTable.astro';
import Faq from '../../components/Faq.astro';
import { BRANDS, PICKS_ORDER, WUYOU_PLANS, has, priceLine, srcLabel, AFF_REL, type Brand } from '../../data/brands';
import { resolveCanonicalUrl } from '../../config/seo';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  return Object.values(BRANDS)
    .filter((b) => b.slug)
    .map((b) => ({ params: { slug: b.slug! }, props: { id: b.id } }));
}

const { id } = Astro.props;
const b: Brand = BRANDS[id]!;
const isWuyou = b.id === 'wuyou';
const hasData = b.tier !== 4;
const others = PICKS_ORDER.filter((x) => x !== b.id).slice(0, 4);
const short = (s: string) => s.replace(/（.*?）/g, '');

const title = hasData ? `${b.name}怎么样？价格、线路与协议资料速查｜机场E家` : `${b.name}官方入口与资料状态｜机场E家`;
const desc = hasData
  ? `${b.name}资料速查：${priceLine(b).slice(0, 36)}；${has(b.line) ? short(b.line).slice(0, 16) + '；' : ''}资料性质为${srcLabel(b)}，附买前检查清单与同类对照，价格以官网为准。`
  : `${b.name}只登记了官方推广入口，价格、线路、协议暂无可核实的公开资料；购买前请以官网页面为准，并先小额试用。`;

const chips = [
  ['价格', priceLine(b)],
  ['线路', has(b.line) ? b.line : '暂无资料'],
  ['协议', has(b.protocols) ? b.protocols : '暂无资料'],
  ['节点', has(b.nodes) ? b.nodes : '暂无资料'],
];
const faq = [
  { q: `${b.name}适合新手吗？`, a: `${b.fit}。如果你只是想第一次试用梯子或机场，先买最低档包月，别一上来买年付。` },
  { q: `${b.name}的价格靠谱吗？`, a: `${priceLine(b)}。价格口径与活动以官网结算页为准；本站不把不同品牌的流量大小或每 GB 单价拿来对比。` },
  { q: `${b.name}的资料是哪里来的？`, a: `资料性质：${srcLabel(b)}（${b.source}）。本站没有对它做速度或稳定性实测，不给评分。` },
  { q: `买${b.name}前要检查什么？`, a: '看退款规则、设备数限制、订阅方式和客户端支持，然后包月试用几个晚高峰；细节见[机场怎么选](/knowledge/how-to-choose-an-airport-proxy/)。' },
];
const path = `/airports/${b.slug}/`;
const ld = { '@context': 'https://schema.org', '@type': 'Article', headline: title, description: desc, dateModified: '2026-09-26', author: { '@type': 'Organization', name: siteConfig.author.name }, url: resolveCanonicalUrl(path) };
---

<BaseLayout title={title} description={desc} keywords={[b.name, `${b.name}怎么样`, `${b.name}机场`]} ogType="article" modifiedTime="2026-09-26">
  <PageShell h1={hasData ? `${b.name}怎么样` : `${b.name}：官方入口与资料状态`} crumbs={[{ name: '机场导航', href: '/airports/' }, { name: b.name, href: path }]} lead={b.tagline} meta={['品牌资料', '更新 2026-09-26', srcLabel(b)]}>
    <div class="keybox"><span class="keybox-label">一句话结论</span><p>{b.fit}。{b.caution}</p></div>

    <h2>资料速查</h2>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead><tr><th>项目</th><th>内容</th></tr></thead>
        <tbody>
          {chips.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
          <tr><th scope="row">客户端</th><td>{has(b.client) ? b.client : '暂无资料'}</td></tr>
          <tr><th scope="row">资料性质</th><td>{srcLabel(b)}（{b.source}）</td></tr>
        </tbody>
      </table>
    </div>

    {
      isWuyou && (
        <>
          <h2>三档套餐（官方页面）</h2>
          <div class="tbl-wrap">
            <table class="tbl">
              <thead><tr><th>档位</th><th>计费</th><th>价格</th></tr></thead>
              <tbody>
                {WUYOU_PLANS.map((p) => <tr><th scope="row">{p.name}</th><td>{p.billing.replace('，低至', '')}</td><td>{/低至/.test(p.billing) ? '低至' : '约'} ¥{p.m}/月{p.name === '省心' ? '起' : ''}</td></tr>)}
              </tbody>
            </table>
          </div>
        </>
      )
    }

    {b.facts.length > 0 && (<><h2>已整理的事实</h2><ul class="lst">{b.facts.map((f) => <li>{f}</li>)}</ul></>)}

    <h2>谁适合，谁先别买</h2>
    <div class="cards-grid">
      <div class="card-link"><i>适合</i><b>{b.fit}</b></div>
      <div class="card-link"><i>先看清</i><b>{b.caution}</b></div>
    </div>

    <p><a class="btn btn-aff btn-lg" href={b.aff} target="_blank" rel={AFF_REL}>访问{b.name}官网</a> <span class="bc-disc">联盟推广链接，价格以官网为准</span></p>

    <h2>买前检查清单</h2>
    <ol class="steps">
      <li><h3>先买包月</h3><p>最低档包月即可，退款、续费规则先看完再付款。</p></li>
      <li><h3>确认设备数与客户端</h3><p>你要用的手机、电脑、路由器是否都支持，见 <a href="/clients/">客户端教程</a>。</p></li>
      <li><h3>晚高峰试几天</h3><p>只在深夜测一次没有意义，连续几天在你常用的时段观察是否稳定。</p></li>
      <li><h3>另备一个低价备用</h3><p>任何服务都可能临时抽风，备用方案见 <a href="/ladder/">梯子怎么选</a> 和 <a href="/vpn/">VPN 怎么选</a>。</p></li>
    </ol>

    <h2>和同类并排看</h2>
    <BrandTable ids={[b.id, ...others]} cols={['price', 'line', 'protocols', 'src']} />

    <Faq items={faq} />
  </PageShell>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</BaseLayout>
