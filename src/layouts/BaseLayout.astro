---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { siteConfig } from '../config/site';
import { resolveCanonicalUrl, type RobotsDirective } from '../config/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  robots?: RobotsDirective;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  keywords?: string[];
}

const { title, description, robots, ogType, ogImage, publishedTime, modifiedTime, keywords } = Astro.props;
const pathname = Astro.url.pathname;
const homepageUrl = resolveCanonicalUrl('/');

// 网站级 JSON-LD：只在此处生成一次，覆盖全站，不逐页重复声明。
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.brandName,
  url: homepageUrl,
};

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.brandName,
  url: homepageUrl,
};
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffcb2e" />
    <script is:inline>
      // 首次绘制前设置 data-theme，避免闪烁。优先级：本站保存的选择 > 默认浅色。
      (function () {
        try {
          var s = localStorage.getItem('ej-theme');
          document.documentElement.setAttribute('data-theme', s === 'dark' ? 'dark' : 'light');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <SEOHead
      title={title}
      description={description}
      pathname={pathname}
      robots={robots}
      ogType={ogType}
      ogImage={ogImage}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      keywords={keywords}
    />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <Analytics />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var tb = document.getElementById('themeBtn');
        function sync() { if (tb) tb.setAttribute('aria-pressed', root.getAttribute('data-theme') === 'dark' ? 'true' : 'false'); }
        if (tb) {
          tb.addEventListener('click', function () {
            var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            try { localStorage.setItem('ej-theme', next); } catch (e) {}
            sync();
          });
        }
        sync();
        var nb = document.getElementById('navBtn'), nav = document.getElementById('siteNav');
        if (nb && nav) {
          nb.addEventListener('click', function () {
            var open = nav.classList.toggle('open');
            nb.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
        }
        var tocLinks = document.querySelectorAll('.toc a[href^="#"]');
        if (tocLinks.length && 'IntersectionObserver' in window) {
          var map = {};
          tocLinks.forEach(function (a) { map[a.getAttribute('href').slice(1)] = a; });
          var io = new IntersectionObserver(function (es) {
            es.forEach(function (e) {
              if (e.isIntersecting) {
                tocLinks.forEach(function (a) { a.classList.remove('on'); });
                var a = map[e.target.id];
                if (a) a.classList.add('on');
              }
            });
          }, { rootMargin: '0px 0px -70% 0px' });
          Object.keys(map).forEach(function (id) { var el = document.getElementById(id); if (el) io.observe(el); });
        }
      })();
    </script>
  </body>
</html>
