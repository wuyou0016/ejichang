---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getArticleHref } from '../../data/utils/article-routing';

const issues = (await getCollection('articles', ({ data }) => data.type === 'troubleshooting')).sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime(),
);

const title = '机场常见问题排查｜连不上、节点慢、订阅导入失败怎么办｜机场E家';
const description = '整理机场代理使用中常见问题的排查思路：连不上、网页打不开、节点速度慢，以及 Clash 导入订阅报错、解析失败等客户端问题，按问题现象分类。';

// 按问题现象分组：连接/速度类问题（现象发生在客户端外部）和客户端本身的
// 报错（现象发生在客户端界面里），这是两类不同的排查入口，分类依据是
// 每篇文章实际处理的问题类型，而不是随意拆分。
const clientErrorIssues = issues.filter((issue) => issue.id === 'clash-import-failed');
const connectionIssues = issues.filter((issue) => issue.id !== 'clash-import-failed');
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={[{ name: '常见问题', href: '/troubleshooting/' }]} />

  <h1>机场常见问题排查</h1>
  <p>
    这里整理机场代理使用过程中常见问题的排查思路。如果你还在配置阶段还没连上过，先看<a href="/tutorials/">客户端使用教程</a>；如果之前能用、现在突然不行了，或者连上了但网页打不开、速度很慢，这里的内容更适合你。
  </p>

  {
    issues.length === 0 && <p>排查内容正在建设中，暂无已发布的文章。</p>
  }

  {
    connectionIssues.length > 0 && (
      <>
        <h2>连接与速度问题</h2>
        <p>连不上、打不开网页、速度突然变慢这类现象。</p>
        <div class="provider-grid">
          {connectionIssues.map((issue) => (
            <a href={getArticleHref(issue)} class="provider-card">
              <span class="provider-card__name">{issue.data.title}</span>
              <p class="provider-card__meta">{issue.data.description}</p>
            </a>
          ))}
        </div>
      </>
    )
  }

  {
    clientErrorIssues.length > 0 && (
      <>
        <h2>客户端报错</h2>
        <p>客户端界面里弹出具体报错信息的情况。</p>
        <div class="provider-grid">
          {clientErrorIssues.map((issue) => (
            <a href={getArticleHref(issue)} class="provider-card">
              <span class="provider-card__name">{issue.data.title}</span>
              <p class="provider-card__meta">{issue.data.description}</p>
            </a>
          ))}
        </div>
      </>
    )
  }

  <p>你可能还想看：</p>
  <ul class="quick-links">
    <li><a href="/tutorials/">查看使用教程</a></li>
    <li><a href="/knowledge/">查看知识库</a></li>
    <li><a href="/airports/">查看机场导航</a></li>
  </ul>
</BaseLayout>
