---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandCard from '../components/BrandCard.astro';
import BrandTable from '../components/BrandTable.astro';
import Faq from '../components/Faq.astro';
import { BRANDS, PICKS_ORDER, WUYOU_PLANS, AFF_REL } from '../data/brands';
import { getArticleHref } from '../data/utils/article-routing';
import { isDemoEntry } from '../data/utils/demo-filter';
import { resolveCanonicalUrl } from '../config/seo';

const w = BRANDS.wuyou!;
const top7 = PICKS_ORDER.slice(0, 7);
const articles = (await getCollection('articles', ({ id }) => !isDemoEntry(id)))
  .sort((a, b) => +new Date(b.data.updatedAt) - +new Date(a.data.updatedAt))
  .slice(0, 6);

const entries = [
  { href: '/ladder/', tag: '梯子', title: '梯子怎么选', desc: '便宜、稳定、免费三种需求怎么判断' },
  { href: '/vpn/', tag: 'VPN', title: 'VPN 怎么选', desc: '一键连的 VPN 适合谁、风险在哪' },
  { href: '/airports/', tag: '机场', title: '机场导航', desc: '29 个品牌入口与价格线路资料' },
  { href: '/subscription/', tag: '订阅', title: '订阅链接', desc: '订阅是什么、怎么导入、怎么转换' },
  { href: '/clients/', tag: '教程', title: '客户端教程', desc: 'Clash、小火箭、安卓一步步照做' },
  { href: '/protocols/', tag: '协议', title: '协议对比', desc: 'SS、Trojan、VLESS、Hysteria2 怎么选' },
  { href: '/troubleshooting/', tag: '排错', title: '排错清单', desc: '连不上、太慢、订阅失败先查什么' },
];
const faq = [
  { q: '梯子、VPN、机场有什么区别？', a: '梯子是口语统称。VPN 通常是官方 App 一键连；机场是订阅链接加客户端，可以自定义规则。详见[梯子怎么选](/ladder/)与[VPN 怎么选](/vpn/)。' },
  { q: '第一次用，应该先买哪个？', a: '先买最低档包月试用，晚高峰用几天再决定是否续费；不要一上来买年付。机场先看[机场导航](/airports/)里资料相对完整的几家。' },
  { q: '机场E家的排序是测速名次吗？', a: '不是。本站没有对任何服务做速度或稳定性实测，也不给评分。顺序按公开资料是否完整、来源是否可核实排列。' },
  { q: '价格为什么写成“包月起步”“年付折算”？', a: '不同服务商口径不同，本站分开标注，不直接比较。价格与活动以官网结算页为准。' },
  { q: '订阅导入失败怎么办？', a: '先查订阅链接是否完整、客户端是否为最新版、系统时间是否准确，再看[订阅导入失败排查](/troubleshooting/clash-import-failed/)。' },
];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '机场E家机场精选',
  itemListElement: top7.map((id, i) => ({ '@type': 'ListItem', position: i + 1, name: BRANDS[id]!.name, url: BRANDS[id]!.slug ? resolveCanonicalUrl(`/airports/${BRANDS[id]!.slug}/`) : undefined })),
};
---

<BaseLayout
  title="机场E家｜梯子、VPN、机场导航与选购资料站"
  description="机场E家整理梯子、VPN、机场代理的选购资料：价格、线路、协议逐条标注来源，附客户端教程与排错清单，首推无忧链接，不发布没有依据的测速与评分。"
  keywords={['梯子', 'VPN', '机场导航', '机场推荐', '便宜梯子', '稳定梯子', '翻墙']}
>
  <main id="main" class="wrap">
    <section class="hero">
      <div>
        <h1>梯子、VPN、机场，<em>先找入口</em>再动手</h1>
        <p class="lead">机场E家把三类工具的选购资料放在一起：该选哪一类、哪家资料完整、怎么导入、连不上怎么查。价格与线路逐条标注来源，没有依据的测速和评分一律不写。</p>
        <div class="ctas">
          <a class="btn btn-lg" href="/ladder/">梯子怎么选</a>
          <a class="btn btn-lg btn-ghost" href="/vpn/">VPN 怎么选</a>
          <a class="btn btn-lg btn-aff" href="/airports/">机场导航</a>
        </div>
      </div>
      <div class="stickers">
        <a class="stk" href="/ladder/">梯子<small>便宜 · 稳定 · 免费</small></a>
        <a class="stk" href="/vpn/">VPN<small>一键连的取舍</small></a>
        <a class="stk" href="/airports/">机场<small>订阅 + 客户端</small></a>
        <a class="stk" href="/clients/">教程<small>照着做就能连</small></a>
      </div>
    </section>

    <h2 class="sec-h">选购入口</h2>
    <div class="scene-grid">
      {entries.map((e) => <a class="scene" href={e.href}><i>{e.tag}</i><b>{e.title}</b><span>{e.desc}</span></a>)}
    </div>

    <section class="feat" aria-label="首推">
      <div>
        <span class="feat-tag">首推</span>
        <h2 class="feat-h">{w.name}</h2>
        <p class="feat-p">第一次试用机场，先从资料相对完整的开始：价格、线路、协议、节点都有官方页面表述。</p>
        <ul class="feat-list">
          {WUYOU_PLANS.map((p) => <li><b>{p.name}</b> {p.billing.replace('，', ' ')}{/低至/.test(p.billing) ? '' : '约'} ¥{p.m}/月{p.name === '省心' ? '起' : ''}</li>)}
        </ul>
        <p class="feat-s">官方页面写明 IPLC / IEPL 线路，协议 VLESS、Trojan、Hysteria2；本站没有实测，请小额包月试用后再决定。</p>
      </div>
      <div class="feat-act">
        <a class="btn btn-aff btn-lg" href={w.aff} target="_blank" rel={AFF_REL}>到官网看套餐</a>
        <small>价格与活动以官网结算页为准</small>
      </div>
    </section>

    <h2 class="sec-h">机场精选 TOP7</h2>
    <div class="bc-list bc-list--3d">
      {top7.map((id, i) => <BrandCard brand={BRANDS[id]!} rank={i + 1} top={i === 0} />)}
    </div>
    <p><a class="btn btn-ghost" href="/airports/">看全部 29 个品牌</a></p>

    <h2 class="sec-h">七家并排看</h2>
    <BrandTable ids={top7} cols={['price', 'line', 'protocols', 'src']} />

    <h2 class="sec-h">三步选对</h2>
    <ol class="steps">
      <li><h3>先分清要哪一类</h3><p>只想装个 App 就用：看 <a href="/vpn/">VPN 怎么选</a>；要分流、多设备、长期用：看 <a href="/ladder/">梯子怎么选</a> 与 <a href="/airports/">机场导航</a>。</p></li>
      <li><h3>小额包月试用</h3><p>挑资料相对完整的 2 家，各买最低档包月，别一上来买年付。</p></li>
      <li><h3>晚高峰自己验证</h3><p>连续几天在你常用的时段观察，稳定再续费；连不上先看 <a href="/troubleshooting/">排错清单</a>。</p></li>
    </ol>

    <h2 class="sec-h">最近更新</h2>
    <div class="cards-grid">
      {articles.map((a) => <a class="card-link" href={getArticleHref(a)}><i>{a.data.category}</i><b>{a.data.title}</b><span>{a.data.description}</span></a>)}
    </div>

    <Faq items={faq} />
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</BaseLayout>
