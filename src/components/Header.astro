---
import { siteConfig } from '../config/site';

// 机场评测板块尚未建成，导航里暂不放这个链接，避免死链。
const navItems = [
  { label: '机场导航', href: '/airports/' },
  { label: '机场推荐', href: '/rankings/' },
  { label: '知识库', href: '/knowledge/' },
  { label: '使用教程', href: '/tutorials/' },
  { label: '常见问题', href: '/troubleshooting/' },
];

const pathname = Astro.url.pathname;
function isActive(href: string): boolean {
  return pathname === href || pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo">
      <span class="site-header__logo-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <defs>
            <linearGradient id="logo-ej-grad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#0d9488" />
              <stop offset="1" stop-color="#2563eb" />
            </linearGradient>
          </defs>
          <rect x="2" y="2" width="20" height="20" rx="6" fill="url(#logo-ej-grad)" />
          <path
            d="M8 7.5h8M8 12h6M8 16.5h8"
            stroke="#fff"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </svg>
      </span>
      <span class="site-header__logo-text">
        <span class="site-header__logo-name">{siteConfig.brandName}</span>
        <span class="site-header__logo-tagline">机场代理导航与推荐</span>
      </span>
    </a>

    <div class="site-header__actions">
      <nav aria-label="主导航" class="site-nav">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <button type="button" class="header-icon-btn theme-toggle" id="theme-toggle" aria-label="切换深色/浅色模式">
        <svg class="theme-toggle__sun" width="18" height="18" viewBox="0 0 32 32" aria-hidden="true">
          <circle cx="16" cy="16" r="5" fill="none" stroke="currentColor" stroke-width="2" />
          <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M16 3v4M16 25v4M3 16h4M25 16h4M6.8 6.8l2.8 2.8M22.4 22.4l2.8 2.8M25.2 6.8l-2.8 2.8M9.6 22.4l-2.8 2.8" />
          </g>
        </svg>
        <svg class="theme-toggle__moon" width="18" height="18" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M23.5 20.8A10.5 10.5 0 0 1 11.2 8.5 10.5 10.5 0 1 0 23.5 20.8Z" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'ej-theme';
    var btns = document.querySelectorAll('.theme-toggle');
    if (!btns.length) return;
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var root = document.documentElement;
        var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem(STORAGE_KEY, next);
        } catch (e) {}
      });
    });
  })();
</script>
