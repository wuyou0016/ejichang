---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShell from '../../components/PageShell.astro';
import BrandCard from '../../components/BrandCard.astro';
import BrandTable from '../../components/BrandTable.astro';
import Faq from '../../components/Faq.astro';
import { BRANDS, PICKS_ORDER } from '../../data/brands';

const ordered = [...PICKS_ORDER, ...Object.keys(BRANDS).filter((id) => !PICKS_ORDER.includes(id))];
const withPage = ordered.filter((id) => BRANDS[id]!.slug);
const entryOnly = ordered.filter((id) => !BRANDS[id]!.slug);
const cardIds = PICKS_ORDER.slice(0, 7);
const faq = [
  { q: '机场导航是什么意思？', a: '这里的“机场”是机场代理服务商，与航班无关。机场导航就是把这些服务商的官方入口和公开资料集中整理，方便你对照。' },
  { q: '排在前面代表更快更稳吗？', a: '不代表。顺序按资料完整度和来源可核实程度排列，本站没有对任何一家做速度或稳定性实测，也不给评分。' },
  { q: '为什么很多品牌只有入口没有资料？', a: '没有可核实的公开资料就写“暂无”，不替它们编造价格、线路或节点。' },
  { q: '机场、梯子、VPN 是一回事吗？', a: '口语上常混用。梯子是统称，VPN 多是官方 App 一键连，机场是订阅链接加客户端；区别和选法见[梯子怎么选](/ladder/)与[VPN 怎么选](/vpn/)。' },
];
---

<BaseLayout
  title="机场导航｜机场代理服务商入口与资料对照｜机场E家"
  description="机场E家机场导航：收录 29 个机场品牌入口，价格、线路、协议、节点逐条标注来源，首推无忧链接；没有依据的测速与评分一律不写，价格以官网为准。"
  keywords={['机场导航', '机场代理', '机场推荐', '机场目录']}
>
  <PageShell h1="机场导航：服务商入口与资料对照" crumbs={[{ name: '机场导航', href: '/airports/' }]} lead="把机场代理服务商的官方入口和公开资料放在一处：价格口径、线路、协议、节点分开写，来源写清楚，缺资料就写“暂无”。" meta={['29 个品牌入口', '更新 2026-09-26', '不含测速与评分']}>
    <div class="keybox"><span class="keybox-label">怎么用</span><p>先看下面资料相对完整的几家，挑 2 家买最低档包月，晚高峰各用几天，再决定续费。还没搞清楚该选梯子、VPN 还是机场？先读 <a href="/ladder/">梯子怎么选</a> 和 <a href="/vpn/">VPN 怎么选</a>。</p></div>

    <h2>资料相对完整的机场</h2>
    <div class="bc-list bc-list--3d">
      {cardIds.map((id, i) => <BrandCard brand={BRANDS[id]!} rank={i + 1} top={i === 0} />)}
    </div>

    <h2>价格、线路、协议、节点并排</h2>
    <BrandTable ids={withPage} />

    <h2>只登记官方入口的品牌</h2>
    <p>这些品牌本站只登记了官方入口，价格、线路、协议、节点暂无可核实的公开资料，请打开官网自行核对。</p>
    <ul class="quick-links">
      {entryOnly.map((id) => <li><a href={BRANDS[id]!.aff} target="_blank" rel="nofollow noopener sponsored">{BRANDS[id]!.name}</a></li>)}
    </ul>

    <Faq items={faq} />
    <div class="related-block">
      <h2>相关阅读</h2>
      <ul>
        <li><a href="/knowledge/how-to-choose-an-airport-proxy/">机场代理怎么选</a></li>
        <li><a href="/knowledge/airport-scam-risk/">机场跑路风险怎么识别</a></li>
        <li><a href="/subscription/">订阅链接是什么、怎么用</a></li>
        <li><a href="/rankings/">机场推荐榜</a></li>
      </ul>
    </div>
  </PageShell>
</BaseLayout>
