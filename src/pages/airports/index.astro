---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPublishableProviders } from '../../data/utils/provider-publish-gate';
import { getRankingPageData } from '../../data/utils/ranking-entries';
import { getTestedProviderStats } from '../../data/utils/tested-providers';
import featured from '../../data/utils/wuyou-lianjie-featured.json';

// 只列出通过发布门槛（真正有独立页面）的 Provider，避免链接到未生成的页面。
const providers = await getPublishableProviders();

const statusLabel: Record<string, string> = {
  active: '正常运营',
  inactive: '暂停服务',
  discontinued: '已停止服务',
  watch: '观察中',
};

function providerCard(provider: (typeof providers)[number]) {
  const noteCount = provider.data.thirdPartyNotes?.length ?? 0;
  return {
    slug: provider.data.slug,
    name: provider.data.name,
    href: `/airports/${provider.data.slug}/`,
    status: provider.data.status,
    statusText: statusLabel[provider.data.status] ?? provider.data.status,
    meta: noteCount > 0 ? `官方公开信息 + ${noteCount} 条第三方资料 + 编辑分析` : '官方公开信息 + 编辑分析',
  };
}
const providerCards = providers.map(providerCard);

// Featured 展示只在无忧链接真的是综合榜第 1 名时才启用——和 /rankings/ 用同一份
// 排名数据校验，不是在这个页面上单独认定的。以后排名变化，这里会自动跟着变回
// 普通目录卡，不需要手动维护两处判断逻辑。
const { entries: overallEntries } = await getRankingPageData('overall');
const isWuyouFirst = overallEntries.length > 0 && overallEntries[0]!.providerSlug === 'wuyou-lianjie';

const featuredCard = isWuyouFirst ? providerCards.find((card) => card.slug === 'wuyou-lianjie') : undefined;
const otherCards = featuredCard ? providerCards.filter((card) => card.slug !== 'wuyou-lianjie') : providerCards;

// "唯一有真实实测"这句话不写死——每次构建都从 tests.json 实际统计有多少个
// 服务商留有真实测试记录，避免以后补了别的服务商的实测数据后文案变成假话。
const { testedCount, totalCount } = await getTestedProviderStats();
const isSoleTested = testedCount === 1;
const featuredName = featuredCard?.name ?? '';
const testedIntro = isSoleTested
  ? `机场E家目前收录了 ${totalCount} 个机场代理服务商，${featuredName} 是唯一一个有本站真实实测数据支撑的——这也是我们把它放在目录最前面的原因。`
  : `机场E家目前收录了 ${totalCount} 个机场代理服务商，${featuredName} 是其中 ${testedCount} 个有本站真实实测数据支撑的服务商之一。`;
const testedPoint = {
  label: isSoleTested ? '目录里唯一留有真实实测记录的服务商' : `目录里 ${testedCount} 个留有真实实测记录的服务商之一`,
  detail: isSoleTested
    ? `本目录其余 ${Math.max(totalCount - 1, 0)} 个服务商目前都只有第三方资料，${featuredName} 是唯一一个站长本人用 MiaoKo 工具留有实测记录的，覆盖 50 个真实节点、5 个实测覆盖地区。`
    : `${featuredName} 是站长本人用 MiaoKo 工具留有实测记录的服务商之一，覆盖 50 个真实节点、5 个实测覆盖地区。`,
};
const directoryPoints = [testedPoint, ...featured.directoryPoints];
---

<BaseLayout
  title="机场导航｜机场代理服务商目录与资料来源整理｜机场E家"
  description="浏览机场E家收录的机场代理服务商目录，每个服务商页面把官方公开信息、第三方资料和编辑分析分开标注来源与时间，不把主观判断包装成客观测试结果。"
>
  <Breadcrumbs items={[{ name: '机场导航', href: '/airports/' }]} />

  <h1>机场导航｜机场代理服务商目录</h1>
  <p>
    本站所说的"机场"，指机场代理服务商，不是现实机场、航班、航站楼或机场交通。这里是我们收录的机场代理服务商目录，帮助你快速找到并了解具体的服务商。
  </p>

  <h2>每个服务商页面会包含什么</h2>
  <p>
    每个服务商页面会用明确的标签区分几类信息：<strong>官方公开信息</strong>（服务商自己发布的套餐、节点介绍，或访问受阻的实际情况）、<strong>第三方资料</strong>（其他公开评测站点记录的价格、测速与解锁描述，逐条标注来源与日期）、<strong>编辑分析</strong>（机场E家基于以上信息形成的判断）。三类信息各自标注来源与时间，不会混在一起呈现，也不会把编辑的主观判断包装成客观测试结果。
  </p>

  <h2>怎么使用机场导航</h2>
  <p>
    如果你还不确定要选哪个服务商，可以先浏览这里收录的服务商列表，点开具体页面逐一查看官方信息、第三方资料和编辑结论。如果你已经明确自己更看重哪个维度，也可以跳过逐个浏览，直接前往<a href="/rankings/">机场推荐</a>，按维度查看已经整理好的候选服务商。还不清楚"机场"到底是什么、和 VPN 有什么区别，可以先看<a href="/knowledge/what-is-airport-proxy/">机场代理是什么</a>；不确定该看哪些维度，可以看<a href="/knowledge/how-to-choose-an-airport-proxy/">机场代理怎么选</a>；下单前想确认下有哪些风险信号值得留意，可以看<a href="/knowledge/airport-scam-risk/">机场"跑路"风险怎么识别</a>。
  </p>

  <h2>当前收录的服务商</h2>
  {
    featuredCard && (
      <div class="standalone-featured">
        <div class="champion">
          <div class="champion__head">
            <span class="champion__rank" aria-hidden="true">1</span>
            <div class="champion__heading">
              <span class="champion__tag">{featured.tag}</span>
              <a href={featuredCard.href} class="champion__name">
                <span class="sr-only">机场导航旗舰推荐：</span>
                {featuredCard.name}
              </a>
            </div>
          </div>

          <p class="champion__intro">{testedIntro}</p>

          <div class="champion__stats">
            {featured.stats.map((stat) => (
              <div class="champion__stat">
                <span class="champion__stat-value">{stat.value}</span>
                <span class="champion__stat-label">{stat.label}</span>
              </div>
            ))}
          </div>

          <div class="champion__section">
            <h3 class="champion__section-title">{featured.directoryTitle}</h3>
            <div class="champion__points">
              {directoryPoints.map((point) => (
                <div class="champion__point">
                  <span class="champion__point-label">{point.label}</span>
                  <p class="champion__point-detail">{point.detail}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="champion__section">
            <h3 class="champion__section-title">核心优点</h3>
            <ul class="champion__advantages">
              {featured.directoryAdvantages.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>

          <a
            href={featuredCard.href}
            class="champion__cta"
            data-analytics-event="recommendation_card_click"
            data-provider={featuredCard.slug}
            data-provider-name={featuredCard.name}
            data-cta-label="机场导航旗舰卡片"
          >
            查看无忧链接完整详情 →
          </a>
        </div>
      </div>
    )
  }
  {
    otherCards.length > 0 ? (
      <div class="provider-grid">
        {otherCards.map((card) => (
          <a
            href={card.href}
            class="provider-card"
            data-analytics-event="recommendation_card_click"
            data-provider={card.slug}
            data-provider-name={card.name}
            data-cta-label="机场导航列表"
          >
            <div class="provider-card__top">
              <span class="provider-card__name">{card.name}</span>
              <span class={`status-dot status-dot--${card.status}`}>{card.statusText}</span>
            </div>
            <p class="provider-card__meta">{card.meta}</p>
            <span class="provider-card__cta">查看详情 →</span>
          </a>
        ))}
      </div>
    ) : (
      !featuredCard && <p>当前暂无已发布的机场代理服务商页面。</p>
    )
  }

  <p>你可能还想看：</p>
  <ul class="quick-links">
    <li><a href="/rankings/">查看机场推荐</a></li>
  </ul>
</BaseLayout>
