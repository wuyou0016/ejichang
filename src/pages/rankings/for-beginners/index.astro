---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RankingEntries from '../../../components/RankingEntries.astro';
import { getRankingPageData } from '../../../data/utils/ranking-entries';
import { resolveCanonicalUrl } from '../../../config/seo';

const { ranking, entries } = await getRankingPageData('for-beginners');

const title = '适合新手的机场推荐｜机场代理入门选择要点｜机场E家';
const description = '介绍新手选择机场代理时可以关注的客户端支持、支持渠道等因素，说明基础信息覆盖评分只衡量官方是否公开这些信息，不代表实际新手体验，并列出当前收录情况。';
const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: resolveCanonicalUrl('/rankings/for-beginners/'),
};
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs
    items={[
      { name: '机场推荐', href: '/rankings/' },
      { name: '适合新手的机场', href: '/rankings/for-beginners/' },
    ]}
  />

  <h1>适合新手的机场推荐｜机场代理入门</h1>
  <p>刚接触机场代理、还不确定怎么选的用户，可以从这个榜单入手。</p>

  <h2>新手选择时可以关注什么</h2>
  <p>
    新手通常更需要客户端是否支持常用平台、是否有清晰的支持渠道，而不是最低的价格或最多的线路。这里的评分是"基础信息覆盖评分"——只衡量官方是否公开了客户端支持、支持渠道这两项信息是否齐全，不代表实际新手体验、配置难度或客服质量，这些当前都没有对应的真实数据支撑。我们不会给出没有数据支持的结论，例如具体的客服响应时间。
  </p>

  <h2>当前收录情况</h2>
  <RankingEntries entries={entries} />
  {ranking && <p>方法论版本：{ranking.data.scoringVersion}，数据快照时间：{ranking.data.snapshotAt.toISOString().slice(0, 10)}。</p>}

  <p>你可能还想看：</p>
  <ul class="quick-links">
    <li><a href="/rankings/">查看机场推荐</a></li>
    <li><a href="/airports/">查看机场导航</a></li>
    <li><a href="/knowledge/what-is-airport-proxy/">机场代理是什么</a></li>
    <li><a href="/tutorials/">机场客户端使用教程</a></li>
  </ul>

  <script type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />
</BaseLayout>
