---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getArticleHref } from '../../data/utils/article-routing';

const tutorials = (await getCollection('articles', ({ data }) => data.type === 'tutorial')).sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime(),
);

const title = '机场客户端使用教程｜Clash / 小火箭 / Android 配置指南｜机场E家';
const description = '机场代理客户端的配置教程，覆盖 Clash（Windows / macOS）、Shadowrocket 小火箭（iOS）、Android 等平台，一步步说明怎么导入订阅、怎么连接。';

// 通用步骤（订阅链接本身怎么用）和具体客户端的安装配置是两类不同的教程，
// 分开展示更符合搜索意图——按 slug 区分，因为这两类目前共用同一个
// category（客户端教程），slug 命名本身已经能稳定区分"how-to-import"和
// 具体平台。
const generalIds = ['airport-getting-started', 'how-to-import-subscription'];
const generalTutorials = tutorials.filter((t) => generalIds.includes(t.id));
const platformTutorials = tutorials.filter((t) => !generalIds.includes(t.id));
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={[{ name: '使用教程', href: '/tutorials/' }]} />

  <h1>机场客户端使用教程</h1>
  <p>
    这里整理各类客户端的配置步骤，帮你从"拿到订阅链接"到"成功连上节点"。如果你还不知道该选哪个机场，可以先看<a href="/rankings/for-beginners/">适合新手的机场推荐</a>；如果连"机场"是什么都还不清楚，建议先看<a href="/knowledge/what-is-airport-proxy/">机场代理是什么</a>；配置过程中遇到报错或连不上，去<a href="/troubleshooting/">常见问题排查</a>。
  </p>

  {
    tutorials.length === 0 && <p>教程正在建设中，暂无已发布的内容。</p>
  }

  {
    generalTutorials.length > 0 && (
      <>
        <h2>通用步骤</h2>
        <p>不管用哪个客户端都适用的入门流程和订阅链接基础知识。</p>
        <div class="provider-grid">
          {generalTutorials.map((tutorial) => (
            <a href={getArticleHref(tutorial)} class="provider-card">
              <span class="provider-card__name">{tutorial.data.title}</span>
              <p class="provider-card__meta">{tutorial.data.description}</p>
            </a>
          ))}
        </div>
      </>
    )
  }

  {
    platformTutorials.length > 0 && (
      <>
        <h2>分平台配置教程</h2>
        <p>按你使用的客户端和系统，查看具体的安装与配置步骤。</p>
        <div class="provider-grid">
          {platformTutorials.map((tutorial) => (
            <a href={getArticleHref(tutorial)} class="provider-card">
              <span class="provider-card__name">{tutorial.data.title}</span>
              <p class="provider-card__meta">{tutorial.data.description}</p>
            </a>
          ))}
        </div>
      </>
    )
  }

  <p>你可能还想看：</p>
  <ul class="quick-links">
    <li><a href="/knowledge/">查看知识库</a></li>
    <li><a href="/airports/">查看机场导航</a></li>
    <li><a href="/rankings/">查看机场推荐</a></li>
    <li><a href="/troubleshooting/">常见问题排查</a></li>
  </ul>
</BaseLayout>
