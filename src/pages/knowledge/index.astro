---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getArticleHref } from '../../data/utils/article-routing';

const articles = (await getCollection('articles', ({ data }) => data.type === 'knowledge')).sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime(),
);

const title = '机场代理知识库｜基础概念、协议与选购指南｜机场E家';
const description = '机场代理相关的基础概念、节点与协议解释、订阅和套餐怎么算、选购判断维度与风险信号，帮助你从完全不了解到能看懂机场推荐榜单和服务商资料。';

// 知识库按 category 字段分成三组展示，而不是简单按发布时间平铺——
// "基础知识"对应"这是什么"、"选购指南"对应"怎么选/划不划算"、
// "风险与安全"对应"要注意什么"，三种不同的搜索意图，分类直接读文章
// 自身的 category 字段，不用额外维护一份手动映射。
const groupOrder = [
  { category: '基础知识', heading: '入门概念', intro: '机场代理、协议、节点这些词具体指什么，机场和 VPN、自建节点有什么区别。' },
  { category: '选购指南', heading: '选购判断', intro: '挑选机场代理时该看哪些维度、怎么算套餐划不划算、怎么付款。' },
  { category: '风险与安全', heading: '风险与安全', intro: '预付费服务常见的风险信号，以及怎么降低风险。' },
];
const knowledgeGroups = groupOrder
  .map((group) => ({ ...group, items: articles.filter((article) => article.data.category === group.category) }))
  .filter((group) => group.items.length > 0);
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={[{ name: '知识库', href: '/knowledge/' }]} />

  <h1>机场代理知识库</h1>
  <p>
    这里回答"机场代理是什么""该看哪些维度"这类基础问题，帮助你从完全不了解到能看懂<a href="/rankings/">机场推荐</a>榜单和<a href="/airports/">机场导航</a>里的服务商信息。如果你已经选好了服务商、想知道具体怎么配置客户端，去<a href="/tutorials/">使用教程</a>；如果是配置好之后遇到问题，去<a href="/troubleshooting/">常见问题排查</a>。
  </p>

  {
    articles.length === 0 && <p>知识库正在建设中，暂无已发布的文章。</p>
  }

  {
    knowledgeGroups.map((group) => (
      <>
        <h2>{group.heading}</h2>
        <p>{group.intro}</p>
        <div class="provider-grid">
          {group.items.map((article) => (
            <a href={getArticleHref(article)} class="provider-card">
              <span class="provider-card__name">{article.data.title}</span>
              <p class="provider-card__meta">{article.data.description}</p>
            </a>
          ))}
        </div>
      </>
    ))
  }

  <p>你可能还想看：</p>
  <ul class="quick-links">
    <li><a href="/airports/">查看机场导航</a></li>
    <li><a href="/rankings/">查看机场推荐</a></li>
    <li><a href="/tutorials/">查看使用教程</a></li>
  </ul>
</BaseLayout>
