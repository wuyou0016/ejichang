---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from './PageShell.astro';
import { siteConfig } from '../config/site';
import { resolveCanonicalUrl } from '../config/seo';
import { estimateReadingTimeMinutes } from '../data/utils/reading-time';
import { getArticleHref } from '../data/utils/article-routing';
import { isDemoEntry } from '../data/utils/demo-filter';

interface Props {
  article: CollectionEntry<'articles'>;
  hubLabel: string;
  hubHref: string;
}

const { article, hubLabel, hubHref } = Astro.props;
const { Content, headings } = await render(article);
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ text: h.text, slug: h.slug }));

const difficultyLabel: Record<NonNullable<CollectionEntry<'articles'>['data']['difficulty']>, string> = {
  beginner: '入门',
  intermediate: '进阶',
  advanced: '高级',
};
const readingTime = estimateReadingTimeMinutes(article.body ?? '');

const allArticles = await getCollection('articles', ({ id }) => !isDemoEntry(id));
const relatedArticles = (article.data.relatedTopics ?? [])
  .map((topicId) => allArticles.find((entry) => entry.id === topicId))
  .filter((entry): entry is CollectionEntry<'articles'> => Boolean(entry));

const iso = (v: Date | string) => (typeof v === 'string' ? new Date(v) : v).toISOString().slice(0, 10);
const publishedAtLabel = iso(article.data.publishedAt);
const updatedAtLabel = iso(article.data.updatedAt);

const meta = [article.data.category];
if (article.data.difficulty) meta.push(`难度 ${difficultyLabel[article.data.difficulty]}`);
meta.push(`发布 ${publishedAtLabel}`);
if (updatedAtLabel !== publishedAtLabel) meta.push(`更新 ${updatedAtLabel}`);
meta.push(`约 ${readingTime} 分钟`);

const href = getArticleHref(article);
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: publishedAtLabel,
  dateModified: updatedAtLabel,
  author: { '@type': 'Organization', name: siteConfig.author.name },
  url: resolveCanonicalUrl(href),
};
---

<BaseLayout
  title={`${article.data.title}｜机场E家`}
  description={article.data.description}
  ogType="article"
  publishedTime={publishedAtLabel}
  modifiedTime={updatedAtLabel}
>
  <PageShell h1={article.data.title} crumbs={[{ name: hubLabel, href: hubHref }, { name: article.data.title, href }]} meta={meta} toc={toc}>
    <div class="prose"><Content /></div>
    {
      relatedArticles.length > 0 && (
        <div class="related-block">
          <h2>相关内容</h2>
          <ul>
            {relatedArticles.map((r) => (
              <li>
                <a href={getArticleHref(r)}>{r.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <div class="related-block">
      <h2>你可能还想看</h2>
      <ul>
        <li><a href="/ladder/">梯子怎么选</a></li>
        <li><a href="/vpn/">VPN 怎么选</a></li>
        <li><a href="/airports/">机场导航</a></li>
        <li><a href="/clients/">客户端教程</a></li>
        <li><a href="/troubleshooting/">故障排查</a></li>
      </ul>
    </div>
  </PageShell>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
</BaseLayout>
